{
	"assignees": ["@scriptex"],
	"extends": [
		"config:base",
		":automergePatch",
		":automergeMinor",
		":automergeBranch",
		":disableDependencyDashboard",
		"group:allNonMajor"
	],
	"labels": ["dependencies", "renovate"],
	"major": {
		"automerge": false
	},
	"packageRules": [
		{
			"matchPackagePatterns": ["babylonjs", "codersrank", "postcss", "serwist", "stylelint", "testing-library"],
			"matchUpdateTypes": ["major"],
			"groupName": "{{packageName}} major"
		}
	],
	"rangeStrategy": "replace",
	"rebaseWhen": "conflicted",
	"schedule": "* * * * 0,6",
	"timezone": "Europe/Sofia",
	"vulnerabilityAlerts": {
		"labels": ["security"],
		"assignees": ["@scriptex"]
	}
}
